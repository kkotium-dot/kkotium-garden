{
  "manifest_version": 3,
  "name": "꽃틔움 미디어 수집기",
  "description": "웹페이지의 이미지와 동영상 URL을 수집하고 필요한 항목을 저장하는 꽃틔움 실무용 수집기",
  "version": "0.2.0",
  "action": {
    "default_title": "꽃틔움 미디어 수집기",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
